# ── App ───────────────────────────────────────────────────────────────
APP_NAME=grd-stk-mkt
ENV=dev
DEBUG=true
API_V1_PREFIX=/api/v1
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── PostgreSQL / TimescaleDB ──────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=grd
POSTGRES_PASSWORD=grd
POSTGRES_DB=grd_stk_mkt
# Full URL is derived from the parts above unless you override it:
# DATABASE_URL=postgresql+psycopg://grd:grd@localhost:5432/grd_stk_mkt

# ── Redis ─────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── Qdrant ────────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=grd_documents

# ── Embeddings / LLM ─────────────────────────────────────────────────
# provider: openai | local
EMBEDDINGS_PROVIDER=local
EMBEDDINGS_MODEL=text-embedding-3-small
EMBEDDINGS_DIM=1536
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=

# ── Market data ──────────────────────────────────────────────────────
# default provider: nse | excel | csv | api
MARKET_DATA_PROVIDER=csv
MARKET_DATA_API_URL=
MARKET_DATA_API_KEY=
MARKET_DATA_DIR=./data/market

# ── Notifications ────────────────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alerts@grd-stk-mkt.local
SMTP_TLS=false
NOTIFY_DEFAULT_CHANNEL=email

# ── Reports ─────────────────────────────────────────────────────────
REPORTS_DIR=./data/reports
REPORTS_ENABLE_PDF=false
