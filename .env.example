# ── App ───────────────────────────────────────────────────────────────
APP_NAME=grd-stk-mkt
ENV=dev
DEBUG=true
API_V1_PREFIX=/api/v1
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Logging ──────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_DIR=./logs                 # set empty to disable file logging
LOG_FILE=app.log               # everything at LOG_LEVEL+
ERROR_LOG_FILE=errors.log      # common exception log — WARNING+ with tracebacks (API + workers)
LOG_FILE_MAX_BYTES=5000000
LOG_FILE_BACKUPS=5

# ── PostgreSQL / TimescaleDB ──────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=grd
POSTGRES_PASSWORD=grd
POSTGRES_DB=grd_stk_mkt
# Full URL is derived from the parts above unless you override it:
# DATABASE_URL=postgresql+psycopg://grd:grd@localhost:5432/grd_stk_mkt

# ── Redis ─────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── Qdrant ────────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=grd_documents

# ── Embeddings / LLM ─────────────────────────────────────────────────
# provider: openai | local
EMBEDDINGS_PROVIDER=local
EMBEDDINGS_MODEL=text-embedding-3-small
EMBEDDINGS_DIM=1536
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=

# ── Market data ──────────────────────────────────────────────────────
# default provider: nse | excel | csv | api
MARKET_DATA_PROVIDER=csv
MARKET_DATA_API_URL=
MARKET_DATA_API_KEY=
MARKET_DATA_DIR=./data/market

# ── Input layer (pluggable connectors) ──────────────────────────────
DOCUMENTS_DIR=./data/documents
UPLOADS_DIR=./data/uploads
UPLOAD_MAX_MB=25
# image OCR backend for the image_ocr connector: stub | tesseract | api
OCR_BACKEND=stub
OCR_LANG=eng
CRAWLER_USER_AGENT=GrdStkMktCrawler/1.0
CRAWLER_DEFAULT_DELAY_SECONDS=1.0
# allow POST /inputs/crawl against private / loopback hosts (dev only)
CRAWLER_ALLOW_PRIVATE=false
#
# Crawler / http_api auth: credentials are read from env vars named in the
# connector config, never stored in the config itself. Example for the
# console.grdworld.com form login:
# GRDWORLD_USER=
# GRDWORLD_PASS=
# ...then the input source config references: {"auth": {"type": "form_login",
#   "login_url": "https://console.grdworld.com/Account/Login",
#   "user_env": "GRDWORLD_USER", "password_env": "GRDWORLD_PASS"}}

# ── Notifications ────────────────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alerts@grd-stk-mkt.local
SMTP_TLS=false
NOTIFY_DEFAULT_CHANNEL=email

# ── Reports ─────────────────────────────────────────────────────────
REPORTS_DIR=./data/reports
REPORTS_ENABLE_PDF=false
