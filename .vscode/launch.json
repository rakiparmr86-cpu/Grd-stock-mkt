{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "API: uvicorn (reload)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "app.main:app", "--reload", "--reload-dir", "app",
        "--host", "127.0.0.1", "--port", "8000"
      ],
      "cwd": "${workspaceFolder}",
      "jinja": true,
      "justMyCode": false,
      "env": { "PYTHONUNBUFFERED": "1" },
      "console": "integratedTerminal"
    },
    {
      "name": "API: uvicorn (no reload — for breakpoints in routes)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--host", "127.0.0.1", "--port", "8000"],
      "cwd": "${workspaceFolder}",
      "jinja": true,
      "justMyCode": false,
      "env": { "PYTHONUNBUFFERED": "1" },
      "console": "integratedTerminal"
    },
    {
      "name": "Celery worker",
      "type": "debugpy",
      "request": "launch",
      "module": "celery",
      "args": ["-A", "app.workers.celery_app", "worker", "-l", "info", "--pool=solo"],
      "cwd": "${workspaceFolder}",
      "justMyCode": false,
      "console": "integratedTerminal"
    },
    {
      "name": "Celery beat",
      "type": "debugpy",
      "request": "launch",
      "module": "celery",
      "args": ["-A", "app.workers.celery_app", "beat", "-l", "info"],
      "cwd": "${workspaceFolder}",
      "justMyCode": false,
      "console": "integratedTerminal"
    },
    {
      "name": "Script: seed_data",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/seed_data.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Pytest: all",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-q"],
      "cwd": "${workspaceFolder}",
      "justMyCode": false,
      "console": "integratedTerminal"
    }
  ]
}
