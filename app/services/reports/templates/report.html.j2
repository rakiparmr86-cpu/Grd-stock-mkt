<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{ title }}</title>
<style>
  :root { color-scheme: light dark; }
  body { font: 14px/1.5 -apple-system, Segoe UI, Roboto, sans-serif; margin: 0;
         background: #fafafa; color: #1a1a1a; }
  .wrap { max-width: 900px; margin: 0 auto; padding: 32px 24px 64px; }
  h1 { font-size: 22px; margin: 0 0 4px; }
  .meta { color: #666; font-size: 12px; margin-bottom: 24px; }
  .card { background: #fff; border: 1px solid #e6e6e6; border-radius: 10px;
          padding: 18px 20px; margin: 16px 0; }
  .badge { display: inline-block; padding: 2px 10px; border-radius: 999px;
           font-size: 12px; font-weight: 600; }
  .buy { background: #e7f6ec; color: #1a7f37; }
  .sell { background: #fdecec; color: #b42318; }
  .alert { background: #fff4e5; color: #9a6700; }
  .rec { font-size: 18px; font-weight: 700; }
  table { border-collapse: collapse; width: 100%; font-size: 13px; }
  th, td { text-align: left; padding: 6px 8px; border-bottom: 1px solid #eee; }
  img { width: 100%; border-radius: 8px; border: 1px solid #eee; }
  .foot { color: #888; font-size: 11px; margin-top: 32px; }
  ul { margin: 6px 0; padding-left: 20px; }
  .note { color: #666; font-size: 12px; margin: 0 0 8px; }
  td.n { text-align: right; font-variant-numeric: tabular-nums; }
  th.n { text-align: right; }
  thead th { background: #f0f3fa; }
  .st-good { color: #1a7f37; font-weight: 600; }
  .st-bad { color: #b42318; font-weight: 600; }
  .st-mid { color: #9a6700; font-weight: 600; }
</style>
</head>
<body>
<div class="wrap">
  <h1>{{ title }}</h1>
  <div class="meta">
    Run #{{ run_id }} &middot; {{ generated_at }} &middot; strategy: {{ strategy or "—" }}
  </div>

  {% if recommendation %}
  <div class="card">
    <div class="rec">
      Recommendation:
      <span class="badge {{ recommendation.action|lower }}">{{ recommendation.action }}</span>
      {% if recommendation.confidence is not none %}
        <span style="color:#666;font-weight:400"> &middot; confidence {{ "%.0f"|format(recommendation.confidence * 100) }}%</span>
      {% endif %}
    </div>
    {% if recommendation.thesis %}<p>{{ recommendation.thesis }}</p>{% endif %}
  </div>
  {% endif %}

  {% if chart_b64 %}
  <div class="card"><img alt="price chart" src="data:image/png;base64,{{ chart_b64 }}"></div>
  {% endif %}

  {% if signals %}
  <div class="card">
    <h3>Triggered signals</h3>
    <table>
      <tr><th>Rule</th><th>Type</th><th>Strength</th><th>Price</th></tr>
      {% for s in signals %}
      <tr>
        <td>{{ s.rule }}</td>
        <td><span class="badge {{ s.signal_type|lower }}">{{ s.signal_type }}</span></td>
        <td>{{ "%.2f"|format(s.strength) }}</td>
        <td>{{ s.price }}</td>
      </tr>
      {% endfor %}
    </table>
  </div>
  {% endif %}

  {% for c in charts %}
  <div class="card">
    <h3>{{ c.heading }}</h3>
    <img alt="{{ c.heading }}" src="data:image/png;base64,{{ c.b64 }}">
  </div>
  {% endfor %}

  {% for t in tables %}
  <div class="card">
    <h3>{{ t.heading }}</h3>
    {% if t.note %}<p class="note">{{ t.note }}</p>{% endif %}
    <table>
      <thead><tr>{% for c in t.columns %}<th{% if not loop.first and t.num %} class="n"{% endif %}>{{ c }}</th>{% endfor %}</tr></thead>
      <tbody>
      {% for row in t.rows %}<tr>{% for cell in row %}
        {% set k = cell|lower %}
        <td class="{% if not loop.first and t.num %}n {% endif %}{% if k in ['strong','positive','attractive/low'] %}st-good{% elif k in ['weak','watch','rich'] %}st-bad{% elif k in ['stable','normal','neutral','neutral-positive'] %}st-mid{% endif %}">{{ cell }}</td>
      {% endfor %}</tr>{% endfor %}
      </tbody>
    </table>
  </div>
  {% endfor %}

  {% for section in sections %}
  <div class="card">
    <h3>{{ section.heading }}</h3>
    {% if section.body %}<p>{{ section.body }}</p>{% endif %}
    {% if section.bullets %}
      <ul>{% for b in section.bullets %}<li>{{ b }}</li>{% endfor %}</ul>
    {% endif %}
  </div>
  {% endfor %}

  {% if forecast %}
  <div class="card">
    <h3>5-year forecast</h3>
    {% for metric, f in forecast.items() %}
    <p style="margin:12px 0 4px">
      <strong>{{ metric|replace("_", " ")|title }}</strong>
      <span style="color:#666">
        {% if f.cagr_pct is not none %}({{ "%.1f"|format(f.cagr_pct) }}% historical CAGR, trending {{ f.trend_direction }}){% endif %}
      </span>
    </p>
    <table>
      <tr><th>Year</th><th>Forecast</th><th>YoY %</th><th>95% CI</th></tr>
      {% for p in f.forecast_path %}
      <tr>
        <td>{{ p.period }}</td>
        <td>{{ "%.0f"|format(p.value) }}</td>
        <td>{{ "%+.1f"|format(p.yoy_pct) if p.yoy_pct is not none else "—" }}</td>
        <td>{{ "%.0f"|format(p.ci_low) }} – {{ "%.0f"|format(p.ci_high) }}</td>
      </tr>
      {% endfor %}
    </table>
    {% endfor %}
    <p class="foot" style="margin-top:8px">
      Statistical (ETS) forecast from historical trend, independent of the scenario
      assumptions elsewhere — the widening CI in later years is the model telling
      you it's guessing further out, not added precision.
    </p>
  </div>
  {% endif %}

  {% if indicators %}
  <div class="card">
    <h3>Latest indicators</h3>
    <table>
      <tr><th>Indicator</th><th>Value</th></tr>
      {% for k, v in indicators.items() %}
      <tr><td>{{ k }}</td><td>{{ "%.4f"|format(v) if v is number else v }}</td></tr>
      {% endfor %}
    </table>
  </div>
  {% endif %}

  <div class="foot">
    Generated by grd-stk-mkt. Not investment advice. Agent decisions are logged
    under analysis_runs / agent_decisions for audit.
  </div>
</div>
</body>
</html>
