<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{ title }}</title>
<style>
  :root { color-scheme: light dark; }
  body { font: 14px/1.5 -apple-system, Segoe UI, Roboto, sans-serif; margin: 0;
         background: #fafafa; color: #1a1a1a; }
  .wrap { max-width: 900px; margin: 0 auto; padding: 32px 24px 64px; }
  h1 { font-size: 22px; margin: 0 0 4px; }
  .meta { color: #666; font-size: 12px; margin-bottom: 24px; }
  .card { background: #fff; border: 1px solid #e6e6e6; border-radius: 10px;
          padding: 18px 20px; margin: 16px 0; }
  .badge { display: inline-block; padding: 2px 10px; border-radius: 999px;
           font-size: 12px; font-weight: 600; }
  .buy { background: #e7f6ec; color: #1a7f37; }
  .sell { background: #fdecec; color: #b42318; }
  .alert { background: #fff4e5; color: #9a6700; }
  .rec { font-size: 18px; font-weight: 700; }
  table { border-collapse: collapse; width: 100%; font-size: 13px; }
  th, td { text-align: left; padding: 6px 8px; border-bottom: 1px solid #eee; }
  img { width: 100%; border-radius: 8px; border: 1px solid #eee; }
  .foot { color: #888; font-size: 11px; margin-top: 32px; }
  ul { margin: 6px 0; padding-left: 20px; }
</style>
</head>
<body>
<div class="wrap">
  <h1>{{ title }}</h1>
  <div class="meta">
    Run #{{ run_id }} &middot; {{ generated_at }} &middot; strategy: {{ strategy or "—" }}
  </div>

  {% if recommendation %}
  <div class="card">
    <div class="rec">
      Recommendation:
      <span class="badge {{ recommendation.action|lower }}">{{ recommendation.action }}</span>
      {% if recommendation.confidence is not none %}
        <span style="color:#666;font-weight:400"> &middot; confidence {{ "%.0f"|format(recommendation.confidence * 100) }}%</span>
      {% endif %}
    </div>
    {% if recommendation.thesis %}<p>{{ recommendation.thesis }}</p>{% endif %}
  </div>
  {% endif %}

  {% if chart_b64 %}
  <div class="card"><img alt="price chart" src="data:image/png;base64,{{ chart_b64 }}"></div>
  {% endif %}

  {% if signals %}
  <div class="card">
    <h3>Triggered signals</h3>
    <table>
      <tr><th>Rule</th><th>Type</th><th>Strength</th><th>Price</th></tr>
      {% for s in signals %}
      <tr>
        <td>{{ s.rule }}</td>
        <td><span class="badge {{ s.signal_type|lower }}">{{ s.signal_type }}</span></td>
        <td>{{ "%.2f"|format(s.strength) }}</td>
        <td>{{ s.price }}</td>
      </tr>
      {% endfor %}
    </table>
  </div>
  {% endif %}

  {% for section in sections %}
  <div class="card">
    <h3>{{ section.heading }}</h3>
    {% if section.body %}<p>{{ section.body }}</p>{% endif %}
    {% if section.bullets %}
      <ul>{% for b in section.bullets %}<li>{{ b }}</li>{% endfor %}</ul>
    {% endif %}
  </div>
  {% endfor %}

  {% if indicators %}
  <div class="card">
    <h3>Latest indicators</h3>
    <table>
      <tr><th>Indicator</th><th>Value</th></tr>
      {% for k, v in indicators.items() %}
      <tr><td>{{ k }}</td><td>{{ "%.4f"|format(v) if v is number else v }}</td></tr>
      {% endfor %}
    </table>
  </div>
  {% endif %}

  <div class="foot">
    Generated by grd-stk-mkt. Not investment advice. Agent decisions are logged
    under analysis_runs / agent_decisions for audit.
  </div>
</div>
</body>
</html>
